{
  "name": "nanahotel",
  "version": "0.1.0",
  "private": true,
  "description": "NanaHotel: an AI hotel concierge (demo): chat to find, book and manage US hotel stays, with simulated inventory and test-mode payments",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/e2e/smoke.mjs",
    "demo": "node test/e2e/run-server.js",
    "test:app": "node test/e2e/app-smoke.mjs",
    "test:merchant": "node test/e2e/merchant-smoke.mjs"
  }
}
