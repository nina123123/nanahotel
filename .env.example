# Copy this file to .env and edit what you need: cp .env.example .env
# .env is read once at startup. Variables already set in the real environment win; .env never overrides them.
# Values may be wrapped in single or double quotes; lines starting with # are comments. Empty = use the default.
# Never commit .env (git ignores it) and never paste a key into a chat, an issue or a screenshot.

# ---------- Server ----------
# Product name, shown in the page title and in how Nana introduces the app (at most 20 characters)
APP_NAME=NanaHotel
# Port to listen on
PORT=8787
# Address to listen on: 127.0.0.1 allows only this computer. Use 0.0.0.0 to open the app from a phone on the same
# Wi-Fi, or inside Docker
HOST=127.0.0.1
# Where conversations, quotes, bookings and traveler details are kept (JSON files); relative to the project folder
DATA_DIR=data
# Time zone for "today" and "tonight" when a browser does not send its own (an IANA name). Default America/New_York
DEFAULT_TIME_ZONE=America/New_York
# Behind a reverse proxy such as nginx set this to 1: rate limits then use the client address from X-Forwarded-For
# (the last hop). Leave it empty without a proxy, because clients can fake that header
TRUST_PROXY=
# Rate limits (per 10 minutes): messages per user, default 30 (1–100000)
CHAT_TURNS_PER_WINDOW=
# Writes (messages, new chats, saving traveler details) per client address, default 600, 0 = no limit (0–100000).
# Raise it when many people share one public address (an office or event Wi-Fi, a mobile carrier network)
WRITES_PER_IP_PER_WINDOW=

# ---------- AI model ----------
# With no key the app runs the built-in demo script (no AI, no cost). The full list of options, the live hotel,
# places, email and ride connectors (LITEAPI_API_KEY, GOOGLE_PLACES_API_KEY, RESEND_API_KEY, …) and where to put
# keys safely are in docs/LIVE.md.
# anthropic or openai; empty = the provider whose key is set (Anthropic when both or neither)
LLM_PROVIDER=
# Anthropic (Claude, the default): https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional model id; empty = the default Claude model
ANTHROPIC_MODEL=
# OpenAI, only if you use it instead: https://platform.openai.com
OPENAI_API_KEY=
# Optional model id; empty = the default OpenAI model
OPENAI_MODEL=
# How much the model thinks before answering: low (faster, cheaper), medium, high. Empty = the provider default
LLM_EFFORT=
# Advanced: a gateway URL, a key and a model that apply to whichever provider is chosen
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_THINKING=
LLM_TEMPERATURE=

# ---------- Web search (optional) ----------
# Bocha Web Search API key: when set, Nana gets a "search the web" tool (opening hours, events); empty = no web search
BOCHA_API_KEY=
