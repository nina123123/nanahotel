# 复制为 .env 后按需修改：cp .env.example .env
# .env 只在启动时读取一次；已经在系统环境变量里设置的值优先，不会被 .env 覆盖。
# 值可以用单引号或双引号包起来；以 # 开头的行是注释。

# ---------- 服务 ----------
# 产品名称，显示在页面标题和 AI 的自我介绍里
APP_NAME=小宿
# 监听端口
PORT=8787
# 监听地址：默认只允许本机访问；想用手机在同一局域网里打开，或在 Docker 里运行，改成 0.0.0.0
HOST=127.0.0.1
# 数据目录（对话、报价、订单、个人信息，JSON 文件）；相对路径以 hotel-agent/ 为基准
DATA_DIR=data
# 放在 nginx 等反向代理后面时填 1：按代理传来的 X-Forwarded-For（最后一跳）识别客户端地址做限流；
# 不填时按连接地址限流，经代理访问的所有用户会共用一个额度。没有反向代理时不要打开（客户端可以伪造这个头）
TRUST_PROXY=
# 限流（每 10 分钟）：每个用户最多发多少条消息，留空默认 30（1–100000）
CHAT_TURNS_PER_WINDOW=
# 每个客户端地址最多多少次写操作（发消息、新建对话、保存个人信息），留空默认 600，0 = 不限（0–100000）。
# 公司 / 活动现场 Wi-Fi、手机运营商网络下很多人共用一个出口 IP，多人同时使用时可以调大
WRITES_PER_IP_PER_WINDOW=

# ---------- 大模型（OpenAI 兼容接口，国内模型） ----------
# 可选：deepseek（默认）、qwen（通义千问/百炼）、kimi（月之暗面）、glm（智谱）、doubao（豆包/火山方舟）
LLM_PROVIDER=deepseek
# 模型名，留空用该厂商的默认模型（deepseek-v4-flash / qwen-flash / kimi-k2.6 / glm-4.7-flash / doubao-seed-2-1-lite-260915）
# 豆包必须填带版本号的模型 ID 或接入点 ID（ep-…）
LLM_MODEL=
# 自定义接口地址，留空用厂商默认地址（例如走自建网关时填写）
LLM_BASE_URL=
# 通用 API Key：填了就优先使用，不填则按厂商读取下面对应的 Key
LLM_API_KEY=
# 深度思考：默认关闭（更快、更便宜）；填 on 打开
LLM_THINKING=
# 采样温度，留空用默认值 0.3（Kimi 不发送该参数）
LLM_TEMPERATURE=

# 各厂商的 API Key，只需要填你选用的那一家
# DeepSeek：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# 阿里云百炼（通义千问）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# 月之暗面 Kimi：https://platform.moonshot.cn
MOONSHOT_API_KEY=
# 智谱 GLM：https://open.bigmodel.cn（也兼容 ZAI_API_KEY）
ZHIPUAI_API_KEY=
# 火山方舟（豆包）：https://console.volcengine.com/ark
ARK_API_KEY=

# ---------- 联网搜索（可选） ----------
# 博查 Web Search API Key：填了才会给 AI 提供「搜寻资料」工具，不填就不提供
BOCHA_API_KEY=
